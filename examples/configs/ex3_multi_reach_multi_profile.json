        "../../data/profiles/reach1_p2.csv"
      ],
      "cshore": { "d50": 0.3 }
    },
    "Reach2": {
      "_description": "Steeper beach face — coarser sand / higher wave energy",
      "profiles": [
        "../../data/profiles/reach2_p0.csv",
        "../../data/profiles/reach2_p1.csv",
        "../../data/profiles/reach2_p2.csv"
      ],
      "cshore": { "d50": 0.4, "gamma": 0.68 }
    },
    "Reach3": {
      "_description": "Dissipative — low berm, gentler slopes",
      "profiles": [
        "../../data/profiles/reach3_p0.csv",
        "../../data/profiles/reach3_p1.csv"
      ],
      "cshore": { "d50": 0.25, "gamma": 0.65, "effb": 0.003 }
    }
  }
