{
  "_description": "Example 3 — 3 reaches, 2-3 profiles each, FWOP only",
  "paths": {
    "storms": "../../data/storms/ex_storms_10s_45d.parquet",
    "output": "../../output/ex3"
  },
  "simulation": {
    "sim_start":    "2025-01-01",
    "sim_end_days": 500
  },
  "cshore": {
    "blp":    0.001,
    "effb":   0.002,
    "gamma":  0.7,
    "efff":   0.005,
    "slp":    0.5,
    "slpot":  0.1,
    "tanphi": 0.63,
    "dx":     1.0,
    "rwh":    0.02,
    "fw":     0.015,
